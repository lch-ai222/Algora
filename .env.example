# --- LLM provider (OpenAI-compatible) ---
# Reused from ft_diag_agent; agent + judge share one provider.
# deepseek | zhipu | openai — see ProviderSpec in src/codeagent_eval/llm.py.
LLM_PROVIDER=deepseek
LLM_ENABLE=true

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-chat
DEEPSEEK_MODEL_PRO=deepseek-reasoner

# Zhipu / GLM. The model ladder switches rungs with the runner's --model flag rather than
# by editing these, so one experiment differs from another by exactly one argument:
#   --model glm-4.6        strong
#   --model glm-4.5-air    mid
#   --model glm-4-flash    weak (restores discrimination on the saturated short suite)
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL_FAST=glm-4.6
ZHIPU_MODEL_PRO=glm-4.6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Call tuning ---
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Cost estimation ---
# Rates are per-model and live in config/pricing.json with a source URL and a read date.
# A model with no usable rate reports cost_source=unavailable rather than 0.0, because a
# zero is indistinguishable from "this was free" everywhere it is later displayed.
PRICING_PATH=config/pricing.json

# --- Observability ---
# none | local_jsonl | otel_jsonl | langfuse_jsonl
LLM_OBSERVABILITY_EXPORTER=local_jsonl
LLM_OBSERVABILITY_EXPORT_PATH=llm_observability.jsonl

# --- Paths ---
ARTIFACTS_DIR=artifacts
DATASETS_DIR=datasets
