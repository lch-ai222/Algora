# Python
__pycache__/
*.py[cod]
.venv/
.venv-evalplus/
*.egg-info/
.pytest_cache/
.ruff_cache/
.cache/evalplus/

# Env / secrets
.env

# Runtime artifacts (traces, patches, logs, sqlite)
artifacts/runs/
# Sanitized failure diagnostics generated by scripts/build_repro_bundle.py. Recreate from the
# source run; cleanup is `rm -rf artifacts/repro_bundles/<bundle-id>`.
artifacts/repro_bundles/
# Offline JSON/Markdown/HTML reports generated from artifacts. Cleanup one report with
# `rm -rf artifacts/reports/<report-id>`.
artifacts/reports/
# Deterministic reference/none boundary runs generated by scripts/check_bounds.py. Cleanup
# with `rm -rf artifacts/bounds/<experiment-id>` or the whole directory when no longer needed.
artifacts/bounds/
# Staging area for external-agent native trajectories; the runner relocates them into the
# trial directory, so anything left here is from direct adapter use.
artifacts/native_trajectories/
*.sqlite3

# Frontend
node_modules/
frontend/dist/

# Personal notes kept beside the repo, never part of it
interview_prep.md
tmp.md
面试口述稿_项目介绍.md

# OS
.DS_Store
